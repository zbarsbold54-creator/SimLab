QWidget {
    background-color: #0F1218;
    color: #E6EAF2;
}
QLabel {
    background-color: transparent;
}
QMainWindow, QToolBar, QStatusBar {
    background-color: #161B24;
}
QToolBar {
    border: 0;
    spacing: 8px;
    padding: 8px;
    margin-left: 8px;
    margin-right: 8px;
}
QPushButton, QLineEdit, QComboBox {
    background-color: #161B24;
    border: 1px solid #232A36;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #4C9AFF;
}
QPushButton:hover, QComboBox:hover {
    border-color: #4C9AFF;
}
QPushButton:pressed {
    background-color: #232A36;
}
QComboBox QAbstractItemView {
    background-color: #161B24;
    border: 1px solid #232A36;
    color: #E6EAF2;
    selection-background-color: #4C9AFF;
}
QComboBox QAbstractItemView::item {
    background-color: #161B24;
    color: #E6EAF2;
    padding: 6px 10px;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #4C9AFF;
}
QComboBox::drop-down {
    background-color: #161B24;
    border-left: 1px solid #232A36;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(icons/chevron.svg);
    width: 12px;
    height: 8px;
}
QStatusBar {
    border-top: 1px solid #232A36;
    color: #8A94A6;
    padding: 8px;
}
QStatusBar QLabel {
    background-color: transparent;
    padding: 0;
}
QStatusBar QWidget#statusInset {
    background-color: transparent;
}
